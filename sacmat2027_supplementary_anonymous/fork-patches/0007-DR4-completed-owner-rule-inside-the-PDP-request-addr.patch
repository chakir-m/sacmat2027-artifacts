diff --git a/backend/app/core/request_context.py b/backend/app/core/request_context.py
new file mode 100644
index 0000000..9cb9708
--- /dev/null
+++ b/backend/app/core/request_context.py
@@ -0,0 +1,8 @@
+"""[eval-fork DR4, request context] Request-scoped values that decision procedures need but whose callers
+do not pass them explicitly (the document read helpers are called from about twenty
+endpoints). Set by a middleware in app.main."""
+from contextvars import ContextVar
+
+# Client address of the current HTTP request; "unknown" when there is none, and for the
+# Hocuspocus-only internal endpoints, whose caller is the collaboration server, not the user.
+client_ip: ContextVar[str] = ContextVar("client_ip", default="unknown")
diff --git a/backend/app/main.py b/backend/app/main.py
index b0ba695..54fc1d3 100644
--- a/backend/app/main.py
+++ b/backend/app/main.py
@@ -182,6 +182,22 @@ async def _csrf_middleware(request: Request, call_next):
     return await call_next(request)
 
 
+# ─── [eval-fork DR4, request context] client address for decision procedures ─────
+# The document read procedure evaluates P_ctx, whose ip_change signal needs the request
+# address. Internal (Hocuspocus-only) calls come from the collaboration server, so the
+# address is left "unknown" there and the signal is not evaluated.
+
+@app.middleware("http")
+async def _client_ip_middleware(request: Request, call_next):
+    from app.core.request_context import client_ip
+    internal = "/internal/" in request.url.path
+    token = client_ip.set("unknown" if internal or not request.client else request.client.host)
+    try:
+        return await call_next(request)
+    finally:
+        client_ip.reset(token)
+
+
 # ─── Metrics middleware ──────────────────────────────────────
 # Tracks every HTTP request. Uses the route template (e.g. /resources/{id})
 # as the `path` label so cardinality stays bounded.
