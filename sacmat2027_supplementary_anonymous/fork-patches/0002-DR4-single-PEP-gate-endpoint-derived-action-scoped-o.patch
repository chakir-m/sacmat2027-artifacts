     return False
 
 
+async def _doc_read_allowed(
+    db: AsyncSession, doc: Document, current: Subject, builtin: Optional[str]
+) -> Optional[bool]:
+    """[eval-fork DR4] One decision procedure for document reads.
+
+    Published documents with a linked Resource are decided by the PDP on that resource
+    (classification, assignment/delegation, risk), exactly as /pep/access would decide.
+    The owner keeps read access only inside the resource's department.
+    For other documents the workflow rules below apply, plus the classification barrier.
+    Returns True/False when decided here, None to fall through to the workflow rules.
+    """
+    from app.services.pdp import (PolicyDecisionPoint, AccessRequest,
+                                  _clearance_rank, _sensitivity_rank)
+    if current.is_platform_admin:
+        return True
+    if doc.status == DocumentStatus.PUBLISHED:
+        linked = (await db.execute(
+            select(Resource).where(Resource.attributes["document_id"].astext == doc.id,
+                                   Resource.is_active == True)  # noqa: E712
+        )).scalars().first()
+        if linked is not None:
+            if doc.owner_id == current.id and linked.department_id == current.department_id:
+                return True
+            dec = await PolicyDecisionPoint(db).decide(AccessRequest(
+                subject_id=current.id, resource_id=linked.id, action="read",
+                context={"surface": "documents",
+                         "timestamp": datetime.now(timezone.utc).isoformat()},
+                _resource=linked))
+            return dec.result == DecisionResult.ALLOW
+    # Unpublished (workflow) documents: classification barrier, with the same role
+    # exemptions as P_class (director in dept, division manager in own division, owner).
+    exempt = (doc.owner_id == current.id
+              or (builtin == "director" and doc.department_id == current.department_id)
+              or (builtin == "division_manager" and doc.department_id == current.department_id
+                  and current.division_id is not None and doc.division_id == current.division_id))
+    if (not exempt and _sensitivity_rank(doc.sensitivity) > 0
+            and _clearance_rank(current.clearance) < _sensitivity_rank(doc.sensitivity)):
+        return False
+    return None
+
+
 async def _assert_can_read(
     db: AsyncSession, doc: Document, current: Subject, builtin: Optional[str]
 ) -> None:
     """Raise 403 if the user cannot read this document under P1-P6 (or as a collaborator)."""
+    decided = await _doc_read_allowed(db, doc, current, builtin)   # [eval-fork DR4]
+    if decided is True:
+        return
+    if decided is False:
+        raise HTTPException(403, "Access denied")
     if _can_read_document(doc, current, builtin):
         return
     # Explicit collaborator invitation — read access at any doc status
