@@ -90,6 +90,80 @@ async def _log_owner_access(
     ))
 
 
+# ══════════════════════════════════════════════════════════════
+# [eval-fork DR4/DR5] single enforcement gate for every file-serving endpoint
+# ══════════════════════════════════════════════════════════════
+_ENDPOINT_ACTION = {"access": "read", "preview": "read", "download": "download"}
+
+
+async def _persist_independently(*rows) -> None:
+    """[eval-fork DR5] audit rows survive a rollback of the request transaction."""
+    from app.db.database import AsyncSessionLocal
+    try:
+        async with AsyncSessionLocal() as s:
+            for r in rows:
+                s.add(r)
+            await s.commit()
+    except Exception as e:
+        logger.error("pep_audit_persist_error", error=str(e))
+
+
+async def _pep_gate(db, current, resource, requested_action, request, surface):
+    """Decide, record, and enforce (including obligations) for one file-serving request.
+    The action is fixed by the endpoint; a different requested action is rejected (400)."""
+    from app.services.pdp import _obligations_for
+    start = time.monotonic()
+    action = _ENDPOINT_ACTION[surface]
+    req_val = getattr(requested_action, "value", requested_action)
+    if surface != "download" and req_val not in (None, action):
+        raise HTTPException(status_code=400,
+                            detail=f"/pep/{surface} serves action '{action}' only")
+    ip = request.client.host if request.client else "unknown"
+    # Owner access only inside the resource's department (no bypass after a move)
+    owner = (resource.owner_id == current.id and resource.department_id == current.department_id)
+    if owner:
+        decision = _owner_decision()
+        decision.obligations = _obligations_for(resource, current)
+    else:
+        decision = await PolicyDecisionPoint(db).decide(AccessRequest(
+            subject_id=current.id, resource_id=resource.id, action=action,
+            context={"request_ip": ip, "user_agent": request.headers.get("user-agent", ""),
+                     "pep_enforced": True, "surface": surface,
+                     "timestamp": datetime.now(timezone.utc).isoformat()},
+            _resource=resource))
+    elapsed_ms = int((time.monotonic() - start) * 1000)
+    allowed = decision.result == DecisionResult.ALLOW
+    obligations = list(getattr(decision, "obligations", []) or []) if allowed else []
+    mfa_block = allowed and "mfa_required" in obligations and not current.mfa_enabled
+    rows = [AuditLog(
+        subject_id=current.id, event_type=AuditEventType.POLICY_DECISION,
+        entity_type="resource", entity_id=resource.id,
+        details={"action": action, "surface": surface, "decision": decision.result.value,
+                 "policy_applied": decision.applied_policy_name, "decision_time_ms": elapsed_ms,
+                 "pep_enforced": True, "obligation_block": "mfa_required" if mfa_block else None,
+                 "subject_email": current.email, "resource_name": resource.name},
+        outcome="allow" if (allowed and not mfa_block) else "deny", ip_address=ip)]
+    if owner:
+        rows.append(AccessDecision(
+            subject_id=current.id, resource_id=resource.id, action=action,
+            result=DecisionResult.ALLOW, applied_policy_id=None, applied_policy_name="Owner Access",
+            context_snapshot={"owner_bypass": True, "surface": surface,
+                              "timestamp": datetime.now(timezone.utc).isoformat()},
+            decision_time_ms=elapsed_ms))
+    await _persist_independently(*rows)
+    if not allowed:
+        raise HTTPException(status_code=403, detail={
+            "error": "Access Denied by Policy", "action": action,
+            "decision": decision.result.value.upper(),
+            "policy_applied": decision.applied_policy_name, "reason": decision.reason,
+            "decision_time_ms": elapsed_ms})
+    if mfa_block:
+        raise HTTPException(status_code=403, detail={
+            "error": "MFA Required", "obligation": "mfa_required", "decision": "DENY",
+            "reason": f"Resource '{resource.name}' requires multi-factor authentication."})
+    return decision, obligations, elapsed_ms
+
+
