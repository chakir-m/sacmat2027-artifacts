@@ -574,6 +574,19 @@ async def revoke_delegation(
     if delegation.status != DelegationStatus.APPROVED:
         raise HTTPException(status_code=400, detail="Only approved delegations can be revoked")
 
+    # [eval-fork F13] authority as documented: approver, admin, or resource owner
+    # (plus the director of the resource's department, who approves delegations)
+    if not current.is_platform_admin:
+        res = delegation.resource
+        _r = (await db.execute(select(Role).where(Role.id == current.role_id))).scalar_one_or_none() \
