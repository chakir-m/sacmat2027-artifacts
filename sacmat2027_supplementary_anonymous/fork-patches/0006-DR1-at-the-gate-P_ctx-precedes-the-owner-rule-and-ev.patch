---
 backend/app/api/documents.py |  6 ++++++
 backend/app/api/pep.py       | 25 ++++++++++++++++++-------
 2 files changed, 24 insertions(+), 7 deletions(-)

diff --git a/backend/app/api/documents.py b/backend/app/api/documents.py
index ab5d074..0e3ff3a 100644
--- a/backend/app/api/documents.py
+++ b/backend/app/api/documents.py
@@ -415,6 +415,12 @@ async def _doc_read_allowed(
                                   _clearance_rank, _sensitivity_rank)
     if current.is_platform_admin:
         return True
+    # [eval-fork DR1] P_ctx precedes every allow rule, including the owner rule and the workflow
+    # rules for unpublished documents (no request IP is available on this path).
+    from app.services.risk import compute_risk_score
+    if compute_risk_score(current, {"timestamp": datetime.now(timezone.utc).isoformat()}).score \
+            >= settings.RISK_DENY_THRESHOLD:
+        return False
     if doc.status == DocumentStatus.PUBLISHED:
         linked = (await db.execute(
             select(Resource).where(Resource.attributes["document_id"].astext == doc.id,
diff --git a/backend/app/api/pep.py b/backend/app/api/pep.py
index b1bbb2d..c654a99 100644
--- a/backend/app/api/pep.py
+++ b/backend/app/api/pep.py
@@ -34,6 +34,7 @@ from app.models.models import (
 )
 from app.services.pdp import PolicyDecisionPoint, AccessRequest, AccessDecisionResult
 from app.services.storage import storage
+from app.services.risk import compute_risk_score
 from app.core.config import settings
 import structlog
 
@@ -119,18 +120,28 @@ async def _pep_gate(db, current, resource, requested_action, request, surface):
         raise HTTPException(status_code=400,
                             detail=f"/pep/{surface} serves action '{action}' only")
     ip = request.client.host if request.client else "unknown"
+    ctx = {"request_ip": ip, "user_agent": request.headers.get("user-agent", ""),
+           "pep_enforced": True, "surface": surface,
+           "timestamp": datetime.now(timezone.utc).isoformat()}
     # Owner access only inside the resource's department (no bypass after a move)
     owner = (resource.owner_id == current.id and resource.department_id == current.department_id)
     if owner:
-        decision = _owner_decision()
-        decision.obligations = _obligations_for(resource, current)
+        # [eval-fork DR1 at the gate] P_ctx precedes the owner rule, as it precedes every allow rule
+        risk = compute_risk_score(current, ctx)
+        if risk.score >= settings.RISK_DENY_THRESHOLD:
+            decision = AccessDecisionResult(
+                result=DecisionResult.DENY, applied_policy_id=None,
+                applied_policy_name="P_ctx – Risk Context Deny",
+                reason=f"Access denied: risk score {risk.score}/100 exceeds threshold "
+                       f"({settings.RISK_DENY_THRESHOLD}). Flags: {', '.join(risk.flags)}",
+                decision_time_ms=0, trace=[])
+        else:
+            decision = _owner_decision()
+            decision.obligations = _obligations_for(resource, current)
     else:
         decision = await PolicyDecisionPoint(db).decide(AccessRequest(
             subject_id=current.id, resource_id=resource.id, action=action,
-            context={"request_ip": ip, "user_agent": request.headers.get("user-agent", ""),
-                     "pep_enforced": True, "surface": surface,
-                     "timestamp": datetime.now(timezone.utc).isoformat()},
-            _resource=resource))
+            context=ctx, _resource=resource))
     elapsed_ms = int((time.monotonic() - start) * 1000)
     allowed = decision.result == DecisionResult.ALLOW
     obligations = list(getattr(decision, "obligations", []) or []) if allowed else []
@@ -146,7 +157,7 @@ async def _pep_gate(db, current, resource, requested_action, request, surface):
     if owner:
         rows.append(AccessDecision(
             subject_id=current.id, resource_id=resource.id, action=action,
-            result=DecisionResult.ALLOW, applied_policy_id=None, applied_policy_name="Owner Access",
+            result=decision.result, applied_policy_id=None, applied_policy_name=decision.applied_policy_name,
             context_snapshot={"owner_bypass": True, "surface": surface,
                               "timestamp": datetime.now(timezone.utc).isoformat()},
             decision_time_ms=elapsed_ms))
