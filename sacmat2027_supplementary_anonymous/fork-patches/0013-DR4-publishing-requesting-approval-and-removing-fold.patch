From 5102307058f11f55b2c6ae7ac947e010eb56543c Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Sat, 21 Nov 2026 22:31:32 +0000
Subject: [PATCH 13/13] DR4: publishing, requesting approval and removing
 folders stay in scope

Found by the state sweep over every in-scope state-changing route: a
director of any department could publish another department's approved
document and move its documents in review to pending approval, and a
division manager of any department could remove another department's
folders. Each route now applies the scope that approval already applies.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 backend/app/api/documents.py | 14 +++++++++++++-
 1 file changed, 13 insertions(+), 1 deletion(-)

diff --git a/backend/app/api/documents.py b/backend/app/api/documents.py
index fa61d8e..6f2c548 100644
--- a/backend/app/api/documents.py
+++ b/backend/app/api/documents.py
@@ -773,7 +773,8 @@ async def delete_folder(
     builtin = await _get_role_builtin(db, current)
     if not current.is_platform_admin and builtin not in ("director", "division_manager"):
         raise HTTPException(403, "Insufficient permissions")
-    if builtin == "director" and space and space.department_id != current.department_id:
+    # [eval-fork DR4, state sweep] a division manager, like a director, acts only in her own department
+    if builtin in ("director", "division_manager") and space and space.department_id != current.department_id:
         raise HTTPException(403, "Access denied")
     folder.is_active = False
     await db.commit()
@@ -1837,6 +1838,14 @@ async def request_approval(
     # Only division managers, directors, and admins can escalate to approval stage
     if builtin not in ("admin", "director", "division_manager") and not current.is_platform_admin:
         raise HTTPException(403, "Only division managers and above can request approval")
+    # [eval-fork DR4, state sweep] as approve: managers and directors act only in their own scope
+    if not current.is_platform_admin:
+        if builtin == "director" and doc.department_id != current.department_id:
+            raise HTTPException(403, "Directors can only act on documents in their department")
+        if builtin == "division_manager" and (
+                (doc.division_id and doc.division_id != current.division_id)
+                or (not doc.division_id and doc.department_id != current.department_id)):
+            raise HTTPException(403, "Division managers can only act on documents in their scope")
     if doc.status != DocumentStatus.REVIEW:
         raise HTTPException(409, "Document must be in review before requesting approval")
     await _transition(db, doc, DocumentStatus.PENDING_APPROVAL, current, body.comment, builtin or "")
@@ -1978,6 +1987,9 @@ async def publish_document(
     builtin = await _get_role_builtin(db, current)
     if builtin not in ("admin", "director") and not current.is_platform_admin:
         raise HTTPException(403, "Only directors and admins can publish documents")
+    # [eval-fork DR4, state sweep] as approve: a director acts only in her own department
+    if builtin == "director" and not current.is_platform_admin and doc.department_id != current.department_id:
+        raise HTTPException(403, "Directors can only publish documents in their department")
     if doc.status != DocumentStatus.APPROVED:
         raise HTTPException(409, "Document must be approved before publishing")
     await _transition(db, doc, DocumentStatus.PUBLISHED, current, body.comment, builtin or "")
