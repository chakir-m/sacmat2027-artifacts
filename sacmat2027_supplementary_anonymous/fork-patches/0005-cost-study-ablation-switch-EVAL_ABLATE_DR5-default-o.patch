From b932d02a348f6ade001e13579d7d2d443821011b Mon Sep 17 00:00:00 2001
From: eval <eval@local>
Date: Fri, 30 Oct 2026 21:57:35 +0000
Subject: [PATCH 05/13] cost-study ablation switch EVAL_ABLATE_DR5 (default
 off)

---
 backend/app/api/pep.py      | 7 ++++++-
 backend/app/services/pdp.py | 7 ++++++-
 2 files changed, 12 insertions(+), 2 deletions(-)

diff --git a/backend/app/api/pep.py b/backend/app/api/pep.py
index 141a988..b1bbb2d 100644
--- a/backend/app/api/pep.py
+++ b/backend/app/api/pep.py
@@ -150,7 +150,12 @@ async def _pep_gate(db, current, resource, requested_action, request, surface):
             context_snapshot={"owner_bypass": True, "surface": surface,
                               "timestamp": datetime.now(timezone.utc).isoformat()},
             decision_time_ms=elapsed_ms))
-    await _persist_independently(*rows)
+    if os.environ.get("EVAL_ABLATE_DR5") == "1":    # cost-study ablation only: rows in the request tx
+        for r in rows:
+            db.add(r)
+        await db.flush()
+    else:
+        await _persist_independently(*rows)
     if not allowed:
         raise HTTPException(status_code=403, detail={
             "error": "Access Denied by Policy", "action": action,
diff --git a/backend/app/services/pdp.py b/backend/app/services/pdp.py
index 82982ac..c0ce46e 100644
--- a/backend/app/services/pdp.py
+++ b/backend/app/services/pdp.py
@@ -29,6 +29,8 @@ import structlog
 _policy_id_cache: Dict[str, str] = {}
 
 logger = structlog.get_logger(__name__)
+import os as _os
+_ABLATE_DR5 = _os.environ.get("EVAL_ABLATE_DR5") == "1"   # cost-study ablation, default off
 
 # ─── Classification helpers ───────────────────────────────────
 _CLEARANCE_RANK = {"normal": 1, "elevated": 2, "delegated": 3}
@@ -124,7 +126,10 @@ class PolicyDecisionPoint:
         pdp_decision_duration_seconds.observe(elapsed)
 
         if not request._no_audit:
-            await self._log_decision(request, result)
+            if _ABLATE_DR5:   # ablation switch for the cost study only (WP4)
+                await self._log_decision_in_request_tx(request, result)
+            else:
+                await self._log_decision(request, result)
         return result
 
     async def _evaluate(self, request: AccessRequest) -> AccessDecisionResult:
-- 
