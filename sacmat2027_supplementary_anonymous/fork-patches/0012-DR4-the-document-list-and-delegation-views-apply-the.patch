@@ -356,9 +363,31 @@ async def get_delegation(
     d = result.scalar_one_or_none()
     if not d:
         raise HTTPException(status_code=404, detail="Delegation not found")
+    # [eval-fork DR4, route inventory] the same visibility as the listing: admin, requester, approver, the
+    # object's owner, the director of the object's department, the division manager of its division
+    if not await _delegation_visible(db, d, current):
+        raise HTTPException(status_code=404, detail="Delegation not found")
     return _to_response(d)
 
 
+async def _delegation_visible(db: AsyncSession, d: Delegation, current: Subject) -> bool:
+    if current.is_platform_admin or current.id in (d.requester_id, d.approver_id):
+        return True
+    if d.resource is not None and d.resource.owner_id == current.id:     # the owner may revoke (F13)
+        return True
+    role = (await db.execute(select(Role).where(Role.id == current.role_id))).scalar_one_or_none() \
+        if current.role_id else None
+    builtin = role.builtin_type if role else None
+    res = d.resource
+    if res is None:
+        return False
+    if builtin == "director":
+        return res.department_id == current.department_id
+    if builtin == "division_manager":
+        return res.division_id is not None and res.division_id == current.division_id
+    return False
+
+
