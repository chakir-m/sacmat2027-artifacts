+# [eval-fork DR3] Versioned grant entries.
+#  * Every grant entry key embeds three generation counters: global, subject, resource.
+#    Invalidation = INCR of a counter (atomic, O(1)); it is performed AFTER the database
+#    commit (see pip_invalidation.py), never before.
+#  * A cache fill uses the generations observed BEFORE its database read, so a fill that
+#    read pre-commit state is written under an outdated key and is never served.
+#  * Entries carry the grant's end of validity; TTL = min(tau, valid_until - now) and an
+#    entry past its end is treated as a miss.
+_GEN_ALL = "pip:gen:all"
+_FILL_GENS: contextvars.ContextVar = contextvars.ContextVar("pip_fill_gens", default=None)
+_LUA_GET = """
+local g0 = redis.call('GET', KEYS[1]) or '0'
+local gs = redis.call('GET', KEYS[2]) or '0'
+local gr = redis.call('GET', KEYS[3]) or '0'
+local v = redis.call('GET', ARGV[1] .. ':' .. g0 .. ':' .. gs .. ':' .. gr) or ''
+return {g0, gs, gr, v}
+"""
+ASSIGNMENT_TTL_S = 120
+DELEGATION_TTL_S = 60
+
 
 class PIPCache:
     """
