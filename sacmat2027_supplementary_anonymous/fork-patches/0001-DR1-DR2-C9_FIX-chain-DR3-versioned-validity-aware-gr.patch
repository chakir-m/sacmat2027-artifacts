+    # [eval-fork DR3] versioned, validity-aware grant entries
+    def _gen_keys(self, subject_id: str, resource_id: str):
+        return [_GEN_ALL, f"pip:gen:s:{subject_id}", f"pip:gen:r:{resource_id}"]
+
+    async def _get_grant(self, base: str, subject_id: str, resource_id: str) -> Optional[list]:
+        client = await self._get_client()
+        if not client:
+            return None
+        try:
+            g0, gs, gr, raw = await client.eval(_LUA_GET, 3, *self._gen_keys(subject_id, resource_id), base)
+        except Exception as e:
+            logger.debug("pip_cache_get_error", key=base, error=str(e))
+            return None
+        fills = _FILL_GENS.get()
+        if fills is None:
+            fills = {}
+            _FILL_GENS.set(fills)
+        fills[base] = f"{g0}:{gs}:{gr}"          # generations observed before the DB read
+        if not raw:
+            return None
+        try:
+            entry = json.loads(raw)
+        except ValueError:
+            return None
+        exp = entry.get("exp")
+        if exp is not None and time.time() >= exp:   # grant ended: never serve it
+            return None
+        return entry.get("actions", [])
+
+    async def _set_grant(self, base: str, actions: list, tau_s: int, valid_until) -> None:
+        fills = _FILL_GENS.get() or {}
+        gens = fills.pop(base, None)
+        if gens is None:          # no generation observed before the read: do not cache
+            return
+        client = await self._get_client()
+        if not client:
+            return
+        ttl_ms = tau_s * 1000
+        exp = None
+        if actions and valid_until is not None:
+            vu = valid_until if valid_until.tzinfo else valid_until.replace(tzinfo=timezone.utc)
+            exp = vu.timestamp()
+            ttl_ms = min(ttl_ms, int((exp - time.time()) * 1000))
+            if ttl_ms <= 0:
+                return
+        try:
+            await client.psetex(f"{base}:{gens}", ttl_ms, json.dumps(
+                {"actions": actions, "exp": exp, "cached_at": datetime.now(timezone.utc).isoformat()}))
+        except Exception as e:
+            logger.debug("pip_cache_set_error", key=base, error=str(e))
 
