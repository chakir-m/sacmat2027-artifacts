@@ -0,0 +1,69 @@
+"""
+[eval-fork DR3] Post-commit invalidation of cached grants.
+
+Every ORM change to a ResourceAssignment or Delegation (insert, update, delete), and every
+bulk UPDATE/DELETE on their tables, is recorded on the session during flush. Only AFTER the
+transaction commits are the corresponding generation counters incremented; a rollback
+discards the record. This covers every code path that changes a grant (assignment creation
+and revocation, delegation approval/rejection/revocation, collaborator add/remove, subject
+deletion, scheduler jobs) without touching the individual endpoints.
+
+The hook is synchronous (SQLAlchemy session events are), so it uses a small synchronous
+Redis client; an INCR costs one round trip.
+"""
+import redis
+import structlog
+from sqlalchemy import event
+from sqlalchemy.orm import Session
+
+from app.core.config import settings
+from app.models.models import ResourceAssignment, Delegation
+
+logger = structlog.get_logger(__name__)
+_KEY = "pip_bump"
+_GRANT_TABLES = {ResourceAssignment.__tablename__, Delegation.__tablename__}
+_sync = None
+
+
+def _client():
+    global _sync
+    if _sync is None:
+        _sync = redis.Redis.from_url(settings.REDIS_URL, socket_connect_timeout=2, socket_timeout=2)
+    return _sync
+
+
+@event.listens_for(Session, "before_flush")
+def _track_orm(session, flush_context, instances):
+    pend = session.info.setdefault(_KEY, set())
+    for obj in list(session.new) + list(session.dirty) + list(session.deleted):
+        if isinstance(obj, ResourceAssignment):
+            pend.add(("s", obj.subject_id)); pend.add(("r", obj.resource_id))
+        elif isinstance(obj, Delegation):
+            pend.add(("s", obj.requester_id)); pend.add(("r", obj.resource_id))
+
+
+@event.listens_for(Session, "do_orm_execute")
+def _track_bulk(state):
+    if state.is_update or state.is_delete:
+        table = getattr(state.statement, "table", None)
+        if table is not None and table.name in _GRANT_TABLES:
+            state.session.info.setdefault(_KEY, set()).add(("all", ""))
+
+
+@event.listens_for(Session, "after_commit")
+def _bump(session):
+    pend = session.info.pop(_KEY, None)
+    if not pend:
+        return
+    try:
+        pipe = _client().pipeline()
+        for kind, ident in pend:
+            pipe.incr("pip:gen:all" if kind == "all" else f"pip:gen:{kind}:{ident}")
+        pipe.execute()
+    except Exception as e:     # cache unreachable: TTL bound (Thm. 3) still applies
+        logger.warning("pip_bump_failed", error=str(e))
+
+
+@event.listens_for(Session, "after_rollback")
+def _discard(session):
+    session.info.pop(_KEY, None)
